PORT=5000
CLIENT_URL=http://localhost:5173

# Oracle Database — use the SAME server and account as your SQL Developer connection
# (e.g. connection name "m8_preprod" or "m8preprod" in the left panel is only a label in SQL Developer;
#  the app does not read that name. Copy Hostname, Port, Service name, Username, Password from that connection.)
#
# In SQL Developer: right-click the connection → Properties (or Edit).
#   - Connection type "Basic": note Hostname, Port, and Service name (or SID).
#   - ORACLE_USER / ORACLE_PASSWORD = the same username and password you use there.
#   - ORACLE_CONNECT_STRING = Easy Connect:  hostname:port/service_name
#     Example: dbhost.example.com:1521/M8PREPROD
#     Use forward slashes in .env paths on Windows (see ORACLE_CLIENT_LIB_DIR below).

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

ORACLE_THICK=1
ORACLE_CLIENT_LIB_DIR=

# Thick mode (Oracle Instant Client) is ON by default when the three vars above are set.
# This avoids NJS-138 on older databases. Install Instant Client and either:
#   - add the folder that contains oci.dll to your PATH, or
#   - set ORACLE_CLIENT_LIB_DIR to that folder, e.g. C:/oracle/instantclient_23_0
#
# Optional explicit flags:
# ORACLE_THICK=1
# Point at the folder that contains oci.dll (use forward slashes on Windows to avoid .env parsing issues)
# ORACLE_CLIENT_LIB_DIR=C:/oracle/instantclient_23_0
#
# Only if your DB is new enough for Thin mode and you do NOT want Instant Client:
# ORACLE_THIN=1

# Project Monitoring: table MONITORING_PROJECTS (with CREATED_AT / UPDATED_AT) is created or
# upgraded automatically on backend startup when Oracle is enabled (unless you opt out below).
# You can still run backend/sql/monitoring-projects.sql manually (idempotent).

# Set to 0/false/no if a DBA creates the table and you do not want the app to run DDL:
# MONITORING_AUTO_DDL=0

# Optional pool tuning
# ORACLE_POOL_MIN=0
# ORACLE_POOL_MAX=10
