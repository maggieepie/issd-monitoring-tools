PORT=5000
CLIENT_URL=http://localhost:5173

# Oracle Database (same host/service/user as in SQL Developer)
# Easy Connect example: your-host:1521/ORCLPDB1
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# If health shows NJS-138 (Thin mode not supported for this DB version), use Thick mode:
# 1) Install Oracle Instant Client (Windows x64 "Basic" or "Basic Light" ZIP from Oracle).
# 2) Unzip to a folder that contains oci.dll, then set ONE of the following:
#
# ORACLE_THICK=1
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19_26
#
# If you only set ORACLE_THICK=1, the folder with oci.dll must be on your PATH.

# Optional pool tuning
# ORACLE_POOL_MIN=0
# ORACLE_POOL_MAX=10
